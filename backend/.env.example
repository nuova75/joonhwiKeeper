# 복사해서 .env 로 사용: cp .env.example .env
PORT=8080
HOST=0.0.0.0
DB_PATH=./data/xkeep.db

# 부모 PWA 웹 푸시 (npm run gen:vapid 로 생성)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.invalid

# Android 에이전트 깨우기용 FCM (Firebase 콘솔 > 서비스 계정 키 JSON 경로). 비워두면 FCM 비활성.
FCM_SERVICE_ACCOUNT=

# 정상 종료 신호(goodbye) 없이 이 시간(분) 이상 연결이 끊긴 기기는 부모에게 경고
OFFLINE_ALERT_MINUTES=20

# 하루 요약 푸시 시각 (기기 시간대 기준 HH:mm). 비우면 끔
SUMMARY_TIME=21:30
