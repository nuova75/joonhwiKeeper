<Project Sdk="Microsoft.NET.Sdk">
  <!-- Agent.Shared 만 참조 → Windows 가 아니어도(Mac/Linux) dotnet test 가능 -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Agent.Shared\Agent.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\..\shared\protocol\fixtures\*.json" LinkBase="fixtures" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
